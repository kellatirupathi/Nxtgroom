# Runtime
NODE_ENV=development
PORT=8000
PROCESS_ROLE=all
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173
CRON_SECRET=

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
# One-off migration confirmation only. Leave unset on the long-running API service.
# DATABASE_PREFLIGHT_APPLY=CREATE_INDEXES

# Authentication. Use unique production values; never commit them.
SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@nxtwave.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# Increment this identifier whenever ADMIN_PASSWORD is intentionally rotated.
ADMIN_PASSWORD_VERSION=1

# Google sign-in (optional). Leave blank to hide the button entirely.
# Sign-in only: the address must already belong to an active user.
GOOGLE_CLIENT_ID=

# Gemini 2.5 Flash-Lite vision evaluation
GEMINI_API_KEY=
# Model, timeout, retry, lease, polling and concurrency values have safe code
# defaults. Add an override only when deliberately tuning a deployment.

# Cloudflare R2 private attendance-photo storage
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# AWS SES (check-in and checkout reports)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials.
AWS_SESSION_TOKEN=
SES_FROM_EMAIL=
# Optional SES configuration set name.
SES_CONFIGURATION_SET=
# SES timeout/retry and notification lease/concurrency values use code defaults.
